---
const currentYear = new Date().getFullYear();
---

<footer class="border-t border-canvas-200 bg-white py-12 text-brand-navy">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 gap-8 md:grid-cols-3">
      <!-- Brand & Mission -->
      <div>
        <span class="text-lg font-extrabold tracking-tight">
          My Sunshine <span class="text-brand-sun">Pet Apparel</span>
        </span>
        <p class="mt-3 text-sm text-brand-muted">
          Handcrafted pet gear made with love, heavy-duty hardware, and reinforced box stitching for every adventure.
        </p>
      </div>

      <!-- Navigation Links -->
      <div>
        <h4 class="text-sm font-bold uppercase tracking-wider text-brand-navy">Quick Links</h4>
        <ul class="mt-3 space-y-2 text-sm text-brand-muted">
          <li><a href="/#shop" class="hover:text-brand-sun transition-colors">Shop All Gear</a></li>
          <li><a href="/about" class="hover:text-brand-sun transition-colors">Our Story & Memorial Fund</a></li>
        </ul>
      </div>

      <!-- Payment & Security Note -->
      <div>
        <h4 class="text-sm font-bold uppercase tracking-wider text-brand-navy">Secure Checkout</h4>
        <p class="mt-3 text-sm text-brand-muted">
          Accepting major credit cards, Square, Afterpay, and digital gift cards.
        </p>
      </div>
    </div>

    <div class="mt-12 border-t border-canvas-200 pt-6 text-center text-xs text-brand-muted">
      &copy; {currentYear} My Sunshine Pet Apparel. All rights reserved.
    </div>
  </div>
</footer>
