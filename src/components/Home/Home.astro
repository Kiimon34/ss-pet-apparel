---
---
<section class="relative overflow-hidden bg-canvas-50 py-16 sm:py-24">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="max-w-2xl">
      <!-- Quality Badge -->
      <span class="inline-block rounded-full bg-brand-sun/20 px-3.5 py-1 text-xs font-bold uppercase tracking-wider text-brand-navy">
        Handmade with Love & Heavy-Duty Hardware
      </span>

      <!-- Primary Headline -->
      <h1 class="mt-4 text-4xl font-extrabold tracking-tight text-brand-navy sm:text-6xl">
        Gear for every walk, ride, and romp.
      </h1>

      <!-- Supporting Body -->
      <p class="mt-6 text-base text-brand-muted sm:text-lg">
        Vibrant, durable, handcrafted dog collars and travel restraints. Built with heavy-duty box stitching and contoured hardware.
      </p>

      <!-- Action Anchors -->
      <div class="mt-8 flex flex-wrap items-center gap-4">
        <a 
          href="/#shop" 
          class="rounded-xl bg-brand-navy px-6 py-3.5 text-sm font-bold text-white shadow-sm hover:bg-brand-navy/90 transition-all focus:outline-none"
        >
          Explore Collection
        </a>
        <a 
          href="/about" 
          class="rounded-xl border border-canvas-200 bg-white px-6 py-3.5 text-sm font-bold text-brand-navy shadow-sm hover:bg-canvas-100 transition-all focus:outline-none"
        >
          Meet the Maker
        </a>
      </div>
    </div>
  </div>
</section>
