---
---
<footer class="border-t border-canvas-200 bg-canvas-50 py-12">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 gap-8 md:grid-cols-3 items-start">
      <!-- Brand & Mission Statement -->
      <div>
        <div class="flex items-center gap-3">
          <img
            src="/images/logo.png"
            alt="My Sunshine Pet Apparel Logo"
            width="44"
            height="44"
            class="h-11 w-11 rounded-full object-cover ring-2 ring-brand-navy/15"
          />
          <div>
            <h3 class="text-base font-extrabold tracking-tight text-brand-navy">
              My Sunshine <span class="text-brand-sun">Pet Apparel</span>
            </h3>
            <p class="text-xs text-brand-muted">Crafted with Love in the USA</p>
          </div>
        </div>
        <p class="mt-3 text-xs leading-relaxed text-brand-muted max-w-xs">
          Built with heavy-duty nylon webbing, box-stitching, and contoured hardware for safety on every adventure.
        </p>
      </div>

      <!-- Quick Navigation -->
      <div>
        <h4 class="text-xs font-bold uppercase tracking-wider text-brand-navy">Quick Links</h4>
        <ul class="mt-3 space-y-2 text-xs font-medium text-brand-muted">
          <li><a href="/#shop" class="hover:text-brand-navy transition-colors">Shop All Gear</a></li>
          <li><a href="/about" class="hover:text-brand-navy transition-colors">Our Story & Memorial Fund</a></li>
          <li><a href="/admin" class="hover:text-brand-navy transition-colors">Store Admin Login</a></li>
        </ul>
      </div>

      <!-- Secure Checkout & Payment Badges -->
      <div>
        <h4 class="text-xs font-bold uppercase tracking-wider text-brand-navy">Secure Checkout</h4>
        <p class="mt-3 text-xs text-brand-muted">
          Accepting major credit cards, Apple Pay, and secure local checkout.
        </p>
        <div class="mt-3 flex items-center gap-2">
          <span class="rounded bg-canvas-200/80 px-2.5 py-1 text-[10px] font-bold text-brand-navy">Visa</span>
          <span class="rounded bg-canvas-200/80 px-2.5 py-1 text-[10px] font-bold text-brand-navy">Mastercard</span>
          <span class="rounded bg-canvas-200/80 px-2.5 py-1 text-[10px] font-bold text-brand-navy">Amex</span>
          <span class="rounded bg-canvas-200/80 px-2.5 py-1 text-[10px] font-bold text-brand-navy">Apple Pay</span>
        </div>
      </div>
    </div>

    <!-- Copyright -->
    <div class="mt-12 border-t border-canvas-200 pt-6 text-center text-xs text-brand-muted">
      &copy; {new Date().getFullYear()} My Sunshine Pet Apparel. All rights reserved.
    </div>
  </div>
</footer>
