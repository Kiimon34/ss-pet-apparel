---
---
<header class="sticky top-0 z-40 w-full border-b border-canvas-200/80 bg-white/80 backdrop-blur-md transition-all">
  <div class="mx-auto flex h-16 max-w-7xl items-center justify-between px-4 sm:px-6 lg:px-8">
    <!-- Brand / Logo Link -->
    <a href="/" class="flex items-center gap-3 group focus:outline-none">
      <img
        src="/images/logo.png"
        alt="My Sunshine Pet Apparel Logo"
        width="40"
        height="40"
        class="h-10 w-10 rounded-full object-cover ring-2 ring-brand-navy/10 transition-transform group-hover:scale-105"
      />
      <div class="flex flex-col">
        <span class="text-base font-extrabold tracking-tight text-brand-navy">
          My Sunshine <span class="text-brand-sun">Pet Apparel</span>
        </span>
        <span class="text-[10px] uppercase font-bold tracking-widest text-brand-muted">
          Handcrafted Gear
        </span>
      </div>
    </a>

    <!-- Navigation & Cart Trigger -->
    <div class="flex items-center gap-6">
      <nav class="hidden md:flex items-center gap-6 text-sm font-semibold text-brand-navy">
        <a href="/#shop" class="hover:text-brand-sun transition-colors">Shop All</a>
        <a href="/about" class="hover:text-brand-sun transition-colors">Our Story</a>
      </nav>

      <!-- Cart Drawer Trigger Button -->
      <button
        id="cart-toggle-btn"
        type="button"
        class="relative flex items-center justify-center rounded-xl bg-canvas-100 p-2.5 text-brand-navy hover:bg-canvas-200 transition-colors focus:outline-none"
        aria-label="Open Cart"
      >
        <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
        </svg>
        <span id="cart-counter" class="absolute -top-1.5 -right-1.5 flex h-5 w-5 items-center justify-center rounded-full bg-brand-sun text-[11px] font-bold text-brand-navy shadow-sm">
          0
        </span>
      </button>
    </div>
  </div>
</header>
