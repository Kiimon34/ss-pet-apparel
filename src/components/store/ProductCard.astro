---
interface Props {
  product: {
    id: string;
    name: string;
    category: string;
    price: number;
    pattern: string;
    sizes: string[];
    image: string;
    badge?: string;
    description: string;
  };
}

const { product } = Astro.props;
---

<article 
  class="product-card group relative flex flex-col overflow-hidden rounded-2xl border border-canvas-200 bg-white shadow-sm transition-all hover:shadow-md"
  data-category={product.category}
>
  <div class="relative aspect-square w-full overflow-hidden bg-canvas-100">
    <img 
      src={product.image} 
      alt={product.name} 
      class="h-full w-full object-cover object-center transition-transform duration-300 group-hover:scale-105"
      loading="lazy"
    />
    {product.badge && (
      <span class="absolute top-3 left-3 rounded-full bg-brand-sun px-2.5 py-1 text-xs font-bold text-brand-navy shadow-sm">
        {product.badge}
      </span>
    )}
  </div>

  <div class="flex flex-1 flex-col p-5">
    <div class="flex items-baseline justify-between gap-2">
      <h3 class="text-base font-bold text-brand-navy">{product.name}</h3>
      <span class="text-base font-extrabold text-brand-navy">${product.price.toFixed(2)}</span>
    </div>
    
    <p class="mt-1 text-xs font-medium text-brand-muted">{product.pattern}</p>
    <p class="mt-2 text-xs text-brand-muted line-clamp-2">{product.description}</p>

    <!-- Size Selector -->
    <div class="mt-4">
      <label class="block text-xs font-semibold text-brand-navy mb-1.5">Select Size:</label>
      <div class="flex flex-wrap gap-1.5 size-options" data-product-id={product.id}>
        {product.sizes.map((size, idx) => (
          <button 
            type="button"
            class={`size-btn rounded-lg border px-2.5 py-1 text-xs font-semibold transition-all ${
              idx === 0 
                ? 'border-brand-navy bg-brand-navy text-white' 
                : 'border-canvas-200 bg-canvas-50 text-brand-navy hover:bg-canvas-100'
            }`}
            data-size={size}
          >
            {size}
          </button>
        ))}
      </div>
    </div>

    <!-- Quick Add Button -->
    <button 
      type="button"
      class="add-to-cart-btn mt-5 flex w-full items-center justify-center rounded-xl bg-brand-sun py-2.5 text-xs font-bold uppercase tracking-wider text-brand-navy hover:bg-amber-400 focus:outline-none transition-colors"
      data-id={product.id}
      data-name={product.name}
      data-price={product.price}
      data-image={product.image}
    >
      Add to Cart
    </button>
  </div>
</article>
