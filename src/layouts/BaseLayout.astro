---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = "My Sunshine Pet Apparel | Handcrafted Dog Collars & Accessories",
  description = "Vibrant, durable, handcrafted dog collars, leashes, and car restraints made with heavy-duty hardware."
} = Astro.props;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/jpeg" href="/images/logo.jpg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body class="min-h-screen bg-canvas-50 text-brand-navy flex flex-col font-sans antialiased">
    
    <!-- Top Navigation Header -->
    <header class="sticky top-0 z-40 w-full border-b border-canvas-200/80 bg-white/80 backdrop-blur-md">
      <div class="mx-auto flex h-16 max-w-7xl items-center justify-between px-4 sm:px-6 lg:px-8">
        
        <!-- Brand Identity with Logo -->
        <a href="/" class="flex items-center gap-3 group focus:outline-none">
          <div class="flex h-11 w-11 items-center justify-center overflow-hidden rounded-xl bg-brand-navy p-1 shadow-sm ring-1 ring-brand-navy/10 transition-transform group-hover:scale-105">
            <img
              src="/images/logo.jpg"
              alt="My Sunshine Pet Apparel Logo"
              class="h-full w-full object-contain"
            />
          </div>
          <div class="flex flex-col">
            <span class="text-base font-extrabold tracking-tight text-brand-navy leading-none">
              My Sunshine <span class="text-brand-sun">Pet Apparel</span>
            </span>
            <span class="text-[10px] uppercase font-bold tracking-widest text-brand-muted mt-1">
              Handcrafted Gear
            </span>
          </div>
        </a>

        <!-- Navigation Links & Cart Trigger -->
        <div class="flex items-center gap-6">
          <nav class="hidden md:flex items-center gap-6 text-sm font-semibold text-brand-navy">
            <a href="/#shop" class="hover:text-brand-sun transition-colors">Shop All</a>
            <a href="/about" class="hover:text-brand-sun transition-colors">Our Story</a>
          </nav>

          <button
            id="cart-toggle-btn"
            type="button"
            class="relative flex items-center justify-center rounded-xl bg-canvas-100 p-2.5 text-brand-navy hover:bg-canvas-200 transition-colors focus:outline-none"
            aria-label="Open Cart"
          >
            <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
            </svg>
            <span id="cart-counter" class="absolute -top-1.5 -right-1.5 flex h-5 w-5 items-center justify-center rounded-full bg-brand-sun text-[11px] font-bold text-brand-navy shadow-sm">
              0
            </span>
          </button>
        </div>
      </div>
    </header>

    <!-- Main Page Content -->
    <main class="flex-grow">
      <slot />
    </main>

    <!-- Site Footer -->
    <footer class="border-t border-canvas-200 bg-canvas-50 py-12">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 gap-8 md:grid-cols-3 items-start">
          <div>
            <div class="flex items-center gap-3">
              <div class="flex h-11 w-11 items-center justify-center overflow-hidden rounded-xl bg-brand-navy p-1 shadow-sm ring-1 ring-brand-navy/10">
                <img
                  src="/images/logo.jpg"
                  alt="My Sunshine Pet Apparel Logo"
                  class="h-full w-full object-contain"
                />
              </div>
              <div>
                <h3 class="text-base font-extrabold tracking-tight text-brand-navy leading-none">
                  My Sunshine <span class="text-brand-sun">Pet Apparel</span>
                </h3>
                <p class="text-xs text-brand-muted mt-1">Crafted with Love in the USA</p>
              </div>
            </div>
            <p class="mt-3 text-xs leading-relaxed text-brand-muted max-w-xs">
              Built with heavy-duty nylon webbing, box-stitching, and contoured hardware for safety on every adventure.
            </p>
          </div>

          <div>
            <h4 class="text-xs font-bold uppercase tracking-wider text-brand-navy">Quick Links</h4>
            <ul class="mt-3 space-y-2 text-xs font-medium text-brand-muted">
              <li><a href="/#shop" class="hover:text-brand-navy transition-colors">Shop All Gear</a></li>
              <li><a href="/about" class="hover:text-brand-navy transition-colors">Our Story & Memorial Fund</a></li>
              <li><a href="/admin" class="hover:text-brand-navy transition-colors">Store Admin Login</a></li>
            </ul>
          </div>

          <div>
            <h4 class="text-xs font-bold uppercase tracking-wider text-brand-navy">Secure Checkout</h4>
            <p class="mt-3 text-xs text-brand-muted">
              Accepting major credit cards, Apple Pay, and secure local checkout.
            </p>
            <div class="mt-3 flex items-center gap-2">
              <span class="rounded bg-canvas-200/80 px-2.5 py-1 text-[10px] font-bold text-brand-navy">Visa</span>
              <span class="rounded bg-canvas-200/80 px-2.5 py-1 text-[10px] font-bold text-brand-navy">Mastercard</span>
              <span class="rounded bg-canvas-200/80 px-2.5 py-1 text-[10px] font-bold text-brand-navy">Amex</span>
              <span class="rounded bg-canvas-200/80 px-2.5 py-1 text-[10px] font-bold text-brand-navy">Apple Pay</span>
            </div>
          </div>
        </div>

        <div class="mt-12 border-t border-canvas-200 pt-6 text-center text-xs text-brand-muted">
          &copy; {new Date().getFullYear()} My Sunshine Pet Apparel. All rights reserved.
        </div>
      </div>
    </footer>

  </body>
</html>
